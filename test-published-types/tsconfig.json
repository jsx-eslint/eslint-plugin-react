{
  // Standalone (does not extend ../tsconfig.json): checks the published types the way a consumer would,
  // with every TypeScript version in the type-check workflow matrix, independent of this repo's own compiler settings.
  "files": [
    "index.js"
  ],

  "compilerOptions": {
    "target": "ES2015",
    "module": "commonjs",
    "lib": ["esnext"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    // index.js only uses CommonJS, which TS understands without @types/node
    "types": [],
    "skipLibCheck": true
  }
}
