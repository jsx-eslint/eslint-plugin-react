{
  "name": "@ysknsid25/eslint-plugin-react",
  "version": "1.0.0",
  "author": "ysknsid25",
  "description": "Fork from `jsx-eslint/eslint-plugin-react`. Main propose is maintaining dependencie updates. React-specific linting rules for ESLint",
  "main": "index.js",
  "types": "index.d.ts",
  "scripts": {
    "clean-built-types": "rm -f $(find . -maxdepth 1 -type f -name '*.d.ts*') $(find lib -type f -name '*.d.ts*' ! -name 'types.d.ts')",
    "prebuild-types": "npm run clean-built-types",
    "build-types": "tsc -p build.tsconfig.json",
    "prepack": "npm run build-types && npmignore --auto --commentLines=autogenerated",
    "prelint": "npm run lint:docs",
    "lint:docs": "markdownlint \"**/*.md\"",
    "postlint:docs": "npm run update:eslint-docs -- --check",
    "lint": "eslint .",
    "postlint": "npm run type-check",
    "pretest": "npm run lint",
    "test": "npm run unit-test",
    "posttest": "npx npm@'>= 10.2' audit --production",
    "type-check": "tsc",
    "unit-test": "istanbul cover node_modules/mocha/bin/_mocha tests/lib/**/*.js tests/util/**/*.js tests/index.js tests/flat-config.js",
    "update:eslint-docs": "eslint-doc-generator"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ouka-lab/eslint-plugin-react"
  },
  "directories": {
    "test": [
      "test",
      "tests",
      "test-published-types"
    ]
  },
  "homepage": "https://github.com/ouka-lab/eslint-plugin-react",
  "bugs": "https://github.com/ouka-lab/eslint-plugin-react/issues",
  "dependencies": {
    "array-includes": "^3.2.0",
    "array.prototype.findlast": "^1.2.5",
    "array.prototype.flatmap": "^1.3.3",
    "array.prototype.tosorted": "^1.1.4",
    "doctrine": "^2.1.0",
    "es-iterator-helpers": "^1.4.0",
    "estraverse": "^5.3.0",
    "hasown": "^2.0.4",
    "jsx-ast-utils": "^2.4.1 || ^3.0.0",
    "minimatch": "^3.1.5",
    "object.entries": "^1.1.9",
    "object.fromentries": "^2.0.8",
    "object.values": "^1.2.1",
    "prop-types": "^15.8.1",
    "resolve": "^2.0.0-next.7",
    "semver": "^6.3.1",
    "string.prototype.matchall": "^4.1.0",
    "string.prototype.repeat": "^1.0.0"
  },
  "devDependencies": {
    "@eslint/core": "^0.17.0",
    "@types/estree": "0.0.52",
    "@types/node": "^22",
    "@typescript-eslint/parser": "^8.58.0",
    "eslint": "^9.7",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-doc-generator": "^3.7.1",
    "eslint-plugin-eslint-plugin": "^5.0.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-remote-tester": "^3.0.1",
    "eslint-remote-tester-repositories": "^1.0.1",
    "eslint-scope": "^3.7.3",
    "espree": "^3.5.4",
    "gfm-footnotes": "^2.0.0",
    "glob": "=10.3.7",
    "istanbul": "^0.4.5",
    "jackspeak": "=2.1.1",
    "ls-engines": "^0.8.1",
    "markdownlint-cli": "^0.8.0 || ^0.32.2",
    "mocha": "^5.2.0",
    "npmignore": "^0.3.5",
    "sinon": "^7.5.0",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "eslint": "^9.7"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "eslint",
    "eslint-plugin",
    "eslintplugin",
    "react"
  ],
  "license": "MIT",
  "publishConfig": {
    "ignore": [
      ".github/",
      "!lib",
      "docs/",
      "test/",
      "test-published-types/",
      "tests/",
      "*.md",
      "*.config.js",
      ".eslint-doc-generatorrc.js",
      ".eslintrc",
      ".editorconfig",
      "tsconfig.json",
      "build.tsconfig.json",
      ".markdownlint*",
      "types",
      "!*.d.ts",
      "!*.d.ts.map"
    ]
  }
}
