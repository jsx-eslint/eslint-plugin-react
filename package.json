{
  "name": "@ysknsid25/eslint-plugin-react",
  "version": "0.0.0",
  "author": "ysknsid25",
  "description": "Fork from `jsx-eslint/eslint-plugin-react`. Main propose is maintaining dependencie updates. React-specific linting rules for ESLint",
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "index.d.ts.map",
    "configs/",
    "lib/"
  ],
  "scripts": {
    "clean-built-types": "rm -f $(find . -maxdepth 1 -type f -name '*.d.ts*') $(find lib -type f -name '*.d.ts*' ! -name 'types.d.ts')",
    "build-types": "pnpm run clean-built-types && tsc -p build.tsconfig.json",
    "prepack": "pnpm run build-types",
    "lint": "pnpm run lint:docs && eslint . && pnpm run type-check",
    "lint:docs": "markdownlint \"**/*.md\" && eslint-doc-generator --check",
    "lint:fix": "eslint . --fix",
    "test": "vitest run --coverage",
    "type-check": "tsc",
    "update:eslint-docs": "eslint-doc-generator",
    "changeset": "changeset"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ouka-lab/eslint-plugin-react"
  },
  "directories": {
    "test": [
      "test",
      "tests",
      "test-published-types"
    ]
  },
  "homepage": "https://github.com/ouka-lab/eslint-plugin-react",
  "bugs": "https://github.com/ouka-lab/eslint-plugin-react/issues",
  "dependencies": {
    "array-includes": "^3.2.0",
    "array.prototype.findlast": "^1.2.5",
    "array.prototype.flatmap": "^1.3.3",
    "array.prototype.tosorted": "^1.1.4",
    "doctrine": "^2.1.0",
    "es-iterator-helpers": "^1.4.0",
    "estraverse": "^5.3.0",
    "hasown": "^2.0.4",
    "jsx-ast-utils": "^2.4.1 || ^3.0.0",
    "minimatch": "^3.1.5",
    "object.entries": "^1.1.9",
    "object.fromentries": "^2.0.8",
    "object.values": "^1.2.1",
    "prop-types": "^15.8.1",
    "resolve": "^2.0.0-next.7",
    "semver": "^6.3.1",
    "string.prototype.matchall": "^4.1.0",
    "string.prototype.repeat": "^1.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/core": "^0.17.0",
    "@eslint/js": "^9.39.5",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/estree": "0.0.52",
    "@types/node": "^22",
    "@typescript-eslint/parser": "^8.58.0",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^9.7",
    "eslint-doc-generator": "^3.7.1",
    "eslint-plugin-eslint-plugin": "^7.6.2",
    "eslint-remote-tester": "^3.0.1",
    "eslint-remote-tester-repositories": "^1.0.1",
    "eslint-scope": "^3.7.3",
    "espree": "^3.5.4",
    "globals": "^17.13.0",
    "ls-engines": "^0.8.1",
    "markdownlint-cli": "^0.49.1",
    "sinon": "^7.5.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "peerDependencies": {
    "eslint": "^9.7"
  },
  "engines": {
    "node": ">=22"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.3.0",
      "onFail": "error"
    }
  },
  "keywords": [
    "eslint",
    "eslint-plugin",
    "eslintplugin",
    "react"
  ],
  "license": "MIT"
}
